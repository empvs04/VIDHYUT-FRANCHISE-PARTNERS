# Server Configuration
PORT=5000
NODE_ENV=development

# MongoDB Atlas Connection
# Format: mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/vidhyut_saathi?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/vidhyut_saathi?retryWrites=true&w=majority

# JWT Authentication
JWT_SECRET=super_secret_vidhyut_saathi_jwt_key_change_in_production_2026
JWT_EXPIRES_IN=7d

# CORS Allowed Origins (Comma separated)
CORS_ORIGIN=http://localhost:3000,http://localhost:5173

# OTP & SMS Gateway Configuration
OTP_EXPIRY_MINUTES=5
OTP_EXPIRY_SECONDS=300
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_ATTEMPTS=5
# In development mode, OTP is logged to console if SMS provider is not active
ENABLE_DEV_OTP_LOG=true

# Real SMS Providers (Optional - Add your API key to send real SMS to mobile)
# MSG91: https://msg91.com
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=
MSG91_SENDER_ID=
# Fast2SMS (India): https://www.fast2sms.com
FAST2SMS_API_KEY=
# 2Factor (India): https://2factor.in
TWOFACTOR_API_KEY=

# Transactional Email Providers (Optional - Add your API key for Email OTPs)
# Resend (https://resend.com), SendGrid (https://sendgrid.com), or Brevo (https://brevo.com)
EMAIL_FROM=support@vidhyutsaathi.com
RESEND_API_KEY=
SENDGRID_API_KEY=
BREVO_API_KEY=

# Initial Super Admin Seed Credentials
ADMIN_NAME=Super Admin
ADMIN_EMAIL=admin@vidhyutsaathi.com
ADMIN_MOBILE=9876543210
ADMIN_PASSWORD=Admin@Vidhyut2026!
